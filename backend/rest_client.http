### 7.8 Entregas sem token -> 401
GET {{host}}/entregas


###############################################################
# 8. RELATORIOS  (somente ADMIN - alimentam os graficos)
###############################################################

### 8.1 Relatorio de vendas (faturamento mensal + categorias + top produtos)
GET {{host}}/relatorios/vendas
Authorization: Bearer {{tokenAdmin}}

### 8.2 Relatorio de vendas com filtro de periodo
GET {{host}}/relatorios/vendas?de=2026-01-01&ate=2026-12-31
Authorization: Bearer {{tokenAdmin}}

### 8.3 Relatorio de estoque (posicao, valor imobilizado e alertas)
GET {{host}}/relatorios/estoque
Authorization: Bearer {{tokenAdmin}}

### 8.4 Relatorio de entregas
GET {{host}}/relatorios/entregas
Authorization: Bearer {{tokenAdmin}}

### 8.5 Relatorio como CLIENTE -> 403
GET {{host}}/relatorios/vendas
Authorization: Bearer {{tokenCliente}}

### 8.6 Relatorio sem token -> 401
GET {{host}}/relatorios/vendas


###############################################################
# 9. ERROS GERAIS
###############################################################

### 9.1 Rota inexistente -> 404
GET {{host}}/rota-que-nao-existe

### 9.2 Token malformado -> 401
GET {{host}}/usuarios/perfil
Authorization: Bearer token-invalido

### 9.3 JSON malformado -> 400
POST {{host}}/login
Content-Type: {{contentType}}

{ "email": "admin@breckbarber.com", "senha": }
